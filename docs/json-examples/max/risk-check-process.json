{
  "processes": [
    {
      "elements": [
        {
          "id": "EndRiskCheck",
          "type": "EndEvent"
        },
        {
          "id": "StartRiskCheck",
          "type": "StartEvent"
        },
        {
          "id": "YetAnotherServiceTask",
          "impl": "${calculateRiskDelegate}",
          "name": "Calculate risk",
          "type": "ServiceTask"
        }
      ],
      "flows": [
        {
          "from": "YetAnotherServiceTask",
          "id": "Flow_Calculate_To_End",
          "to": "EndRiskCheck",
          "type": "SequenceFlow"
        },
        {
          "from": "StartRiskCheck",
          "id": "Flow_Start_To_Calculate",
          "to": "YetAnotherServiceTask",
          "type": "SequenceFlow"
        }
      ],
      "id": "risk-check-process",
      "name": "Risk check process",
      "type": "Process"
    }
  ]
}
