  },
  "processes": [
    {
      "elements": [
        {
          "execution": {
            "camunda:asyncAfter": false,
            "camunda:asyncBefore": true,
            "camunda:delegateExpression": "${publishDecisionDelegate}",
            "camunda:exclusive": true
          },
          "id": "Activity_0jo48pq",
          "incoming": [
