          ],
          "name": "Publish decision",
          "outgoing": [
            "Flow_Publish_To_End"
          ],
          "type": "bpmn:ServiceTask"
        },
        {
          "calledElement": "risk-check",
          "execution": {
            "camunda:asyncAfter": false,
            "camunda:asyncBefore": true,
            "camunda:exclusive": true
          },
          "extensions": [
            {
              "source": "applicationId",
              "target": "applicationId",
              "type": "camunda:In"
            },
            {
              "source": "applicantName",
              "target": "clientId",
              "type": "camunda:In"
            },
            {
              "source": "clientId",
              "target": "applicantName",
              "type": "camunda:In"
            },
            {
              "source": "amount",
              "target": "loanAmount",
              "type": "camunda:In"
            },
            {
              "sourceExpression": "riskScore",
              "target": "riskScore",
              "type": "camunda:Out"
            }
          ],
          "id": "CallRiskCheck",
          "incoming": [
            "Flow_Save_To_Risk"
          ],
          "name": "Run risk check",
          "outgoing": [
            "Flow_Risk_To_Publish"
          ],
          "type": "bpmn:CallActivity"
        },
        {
          "execution": {
            "camunda:asyncAfter": false,
