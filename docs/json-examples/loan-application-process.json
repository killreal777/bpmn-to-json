          ],
          "type": "bpmn:ServiceTask"
        },
        {
          "execution": {
            "camunda:asyncAfter": false,
            "camunda:asyncBefore": false,
            "camunda:exclusive": true
          },
          "id": "StartLoanApplication",
          "outgoing": [
            "Flow_Start_To_Save"
          ],
          "type": "bpmn:StartEvent"
        }
      ],
      "flows": [
        {
          "id": "Flow_Publish_To_End",
          "sourceRef": "Activity_0jo48pq",
          "targetRef": "EndLoanApplication",
          "type": "bpmn:SequenceFlow"
