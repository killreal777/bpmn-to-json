            "Flow_Publish_To_End"
          ],
          "type": "bpmn:EndEvent"
        },
        {
          "execution": {
            "camunda:asyncAfter": false,
            "camunda:asyncBefore": true,
            "camunda:delegateExpression": "${saveApplicationDelegate}",
            "camunda:exclusive": true
          },
          "id": "SaveApplication",
          "incoming": [
            "Flow_Start_To_Save"
