{
  "processes": [
    {
      "elements": [
        {
          "meta": "EndRiskCheck,EndEvent"
        },
        {
          "meta": "StartRiskCheck,StartEvent"
        },
        {
          "meta": "YetAnotherServiceTask,ServiceTask,Calculate risk,impl=${calculateRiskDelegate}",
          "execution": {
            "camunda:asyncBefore": true
          }
        }
      ],
      "flows": [
        "YetAnotherServiceTask,EndRiskCheck",
        "StartRiskCheck,YetAnotherServiceTask"
      ],
      "id": "risk-check-process",
      "name": "Risk check process",
      "type": "bpmn:Process"
    }
  ]
}
